{
  "name": "@panabarbero/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".":{
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    }
  },
  "scripts": {
    "dev": "tsc --watch --project tsconfig.build.json & bun run --hot src/index.ts",
    "build": "bun build src/index.ts --outdir=dist --target bun --splitting",
    "start": "bun run dist/src/index.js"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.1.0",
    "@hono/zod-openapi": "^1.1.0",
    "@panabarbero/auth": "workspace:*",
    "@panabarbero/constants": "workspace:*",
    "@scalar/hono-api-reference": "^0.9.16",
    "hono": "^4.9.5"
  },
  "devDependencies": {
    "@types/bun": "^1.2.21"
  }
}
