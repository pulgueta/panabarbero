{
  "name": "panabarbero",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "biome lint --write --unsafe .",
    "format": "biome format --write .",
    "doctor:full": "pnpm --filter @panabarbero/web doctor:full",
    "doctor:diff": "pnpm --filter @panabarbero/web doctor:diff"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "turbo": "2.11.10",
    "typescript": "catalog:"
  }
}
