{
  "name": "panabarbero",
  "private": true,
  "engines": {
    "bun": ">=1.2.21"
  },
  "packageManager": "bun@1.2.21",
  "scripts": {
    "start": "turbo run start",
    "build": "turbo run build",
    "clean": "git clean -xdf node_modules",
    "clean:workspaces": "turbo run clean",
    "auth:generate": "cd packages/auth && bunx @better-auth/cli generate --config src/index.ts --output src/auth-schema.ts",
    "db:generate": "cd packages/db && bun run generate",
    "db:migrate": "cd packages/db && bun run migrate",
    "db:studio": "cd packages/db && bun run studio",
    "dev": "turbo watch dev --continue",
    "lint": "biome lint --write --unsafe .",
    "format": "biome format --write .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.4",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@commitlint/format": "^19.8.1",
    "@semantic-release/changelog": "^6.0.3",
    "@types/bun": "^1.2.21",
    "conventional-changelog-atom": "^5.0.0",
    "husky": "^9.1.7",
    "postgres": "^3.4.7",
    "semantic-release": "^24.2.8",
    "turbo": "^2.5.6",
    "typescript": "catalog:"
  },
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "react": "19.1.0",
      "react-dom": "19.1.0",
      "@types/react": "19.1.10",
      "@types/react-dom": "19.1.9",
      "typescript": "5.9.2"
    }
  },
  "dependencies": {
    "@t3-oss/env-core": "^0.13.8",
    "zod": "^4.1.8"
  },
  "trustedDependencies": [
    "@prisma/client",
    "@prisma/engines",
    "@tailwindcss/oxide",
    "better-sqlite3",
    "esbuild",
    "prisma",
    "sharp"
  ]
}
