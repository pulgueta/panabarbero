{
  "name": "panabarbero",
  "private": true,
  "engines": {
    "bun": ">=1.2.19"
  },
  "packageManager": "bun@1.2.19",
  "scripts": {
    "build": "turbo run build",
    "clean": "git clean -xdf node_modules",
    "clean:workspaces": "turbo run clean",
    "auth:generate": "cd packages/auth && bunx @better-auth/cli generate --config src/index.ts --output src/auth-schema.ts",
    "db:generate": "cd packages/db && bun run generate",
    "db:migrate": "cd packages/db && bun run migrate",
    "dev": "turbo watch dev --continue",
    "lint": "biome lint --write --unsafe .",
    "format": "biome format --write .",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "changeset:autogenerate": "bun .changeset/changesets-autogenerate.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.1.4",
    "@changesets/changelog-github": "^0.5.1",
    "@changesets/cli": "^2.29.5",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@commitlint/format": "^19.8.1",
    "@semantic-release/changelog": "^6.0.3",
    "@types/bun": "^1.2.19",
    "conventional-changelog-atom": "^5.0.0",
    "husky": "^9.1.7",
    "semantic-release": "^24.2.7",
    "turbo": "^2.5.5",
    "typescript": "^5.9.2"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
