{
  "exclude": [
    "node_modules",
    "dist",
    "build",
    ".turbo",
    ".cache"
  ],
  "include": ["./src/**/*.ts", "./src/**/*.tsx", "./env/**/*.ts"],
  "compilerOptions": {
    "verbatimModuleSyntax": true,
    "module": "ESNext",
    "lib": ["ES2022"],
    "target": "es2022",
    "strict": true,
    "skipLibCheck": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "resolveJsonModule": true
  }
}
